# ════════════════════════════════════════════════════════════════════════
#  CH BEAUTYROOM – Umgebungsvariablen
#  Diese Datei als .env.local kopieren und ausfüllen. .env.local wird nicht
#  mit ins Repository übernommen.
# ════════════════════════════════════════════════════════════════════════

# --- Welcher Versandweg? ------------------------------------------------
# resend    = eigener Versand über resend.com (empfohlen, zwei E-Mails)
# formspree = Weiterleitung an einen Formspree-Endpunkt
MAIL_PROVIDER=resend

# --- Weg 1: Resend ------------------------------------------------------
# API-Key von https://resend.com. Wird nur serverseitig gelesen.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Absenderadresse. Die Domain muss bei Resend verifiziert sein.
MAIL_FROM="CH Beautyroom <termin@deine-domain.de>"

# Postfach, in dem die Anfragen landen.
MAIL_TO="deine-adresse@example.de"

# --- Weg 2: Formspree ---------------------------------------------------
# Nur nötig, wenn MAIL_PROVIDER=formspree gesetzt ist.
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# --- Allgemein ----------------------------------------------------------
# Vollständige Basis-URL ohne Schrägstrich am Ende.
NEXT_PUBLIC_SITE_URL=https://www.ch-beautyroom.de
