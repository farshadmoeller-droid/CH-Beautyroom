# --- E-Mail-Versand ---------------------------------------------------------
# Resend API-Key (https://resend.com). Wird ausschliesslich serverseitig genutzt.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Absenderadresse. Muss eine bei Resend verifizierte Domain sein.
MAIL_FROM="CH Beautyroom <termin@deine-domain.de>"

# Postfach der Inhaberin: hierhin gehen die Terminanfragen.
MAIL_TO="deine-adresse@example.de"

# --- Optionale Alternative: SMTP statt Resend -------------------------------
# Wenn MAIL_TRANSPORT=smtp gesetzt ist, wird lib/mail.ts auf Nodemailer
# umgestellt. Dann zusaetzlich "npm install nodemailer" ausfuehren.
# MAIL_TRANSPORT=resend
# SMTP_HOST=smtp.example.de
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Allgemein --------------------------------------------------------------
# Vollstaendige Basis-URL der Website (ohne Slash am Ende).
NEXT_PUBLIC_SITE_URL=https://www.ch-beautyroom.de
